{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "extends": [
    "config:recommended",
    "schedule:weekly",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "description": "Group Kotlin and KSP updates together",
      "groupName": "kotlin",
      "matchPackageNames": [
        "/org.jetbrains.kotlin.*/",
        "/com.google.devtools.ksp/"
      ]
    },
    {
      "description": "Group GitHub Actions workflow updates together",
      "groupName": "github-actions",
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "description": "Group Ruby / Fastlane dependencies together",
      "groupName": "fastlane",
      "matchManagers": [
        "bundler"
      ]
    },
    {
      "description": "Ignore ktfmt updates until repository formatting is updated",
      "matchPackageNames": [
        "com.ncorti.ktfmt.gradle",
        "com.facebook:ktfmt"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
